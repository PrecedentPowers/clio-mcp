CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_PORT=5678
CLIO_AUTH_URL= https://app.clio.com/oauth/authorize #https://eu.app.clio.com/oauth/authorize
CLIO_TOKEN_URL=https://app.clio.com/oauth/token #https://eu.app.clio.com/oauth/token
CLIO_API_BASE=https://app.clio.com/api/v4 #https://eu.app.clio.com/api/v4
CLIO_REGION=us #eu
# Optional: overrides OS keychain (use for CI/headless installs)
ENCRYPTION_KEY=
TRANSPORT=
MCP_BASE_URL=http://127.0.0.1:3000

# Optional: default responsible-attorney Clio user ID.
# Shown in matter tool hints; auto-applied to create_matter ONLY in stdio (single-user) mode.
CLIO_DEFAULT_ATTORNEY_ID=

# HTTP mode security
# Required when MCP_BASE_URL is non-local — the server refuses to start without it.
MCP_API_KEY=
# Extra Host header values to accept (comma-separated), e.g. behind a reverse proxy.
MCP_ALLOWED_HOSTS=
# Set to "off" to disable DNS-rebinding protection (default: on).
MCP_DNS_REBINDING_PROTECTION=
